# 複製為 .env 後填入實際值（.env 已在 .gitignore）
# LINE Developers Console → Messaging API
# ⚠️ 舊憑證曾明碼寫在 legacy/app.py，務必先 reissue token / regenerate secret
LINE_CHANNEL_ACCESS_TOKEN=
LINE_CHANNEL_SECRET=

# 地端 LLM（Ollama 跑在宿主機，不在容器裡——見 README 決策 15）
# 沒有任何雲端 API 金鑰：轉錄與抽取都在本機完成。
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=qwen3.5:9b

# 基礎設施（本機開發用預設值，正式環境必換）
POSTGRES_DB=svra
POSTGRES_USER=svra
POSTGRES_PASSWORD=svra-dev-only
RABBITMQ_USER=svra
RABBITMQ_PASSWORD=svra-dev-only

# core
# 8443 是對外的 webhook 埠；actuator 走 8444，不對外開（見 README 決策 20）
SERVER_PORT=8443
MANAGEMENT_PORT=8444
# core 與 whisper-worker 交換音檔的共享目錄。
# 相對路徑會依「從哪裡啟動」而變，run-core.sh 會把它指成絕對路徑。
AUDIO_DIR=./data/audio

# Whisper worker
# tiny/base/small/medium/large-v3 —— 首次煙霧測試建議 tiny（模型小、下載快）
WHISPER_MODEL=phate334/Breeze-ASR-25-ct2   # 聯發科台灣調校版；改 small 可換回快但較不準的
WHISPER_DEVICE=cpu
WHISPER_COMPUTE_TYPE=int8
# 轉錄成功後刪掉音檔。逐字稿已經進資料庫，留著只是讓語音資料一直堆積。
WHISPER_DELETE_AUDIO=true
