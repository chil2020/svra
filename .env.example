# 複製為 .env 後填入實際值（.env 已在 .gitignore）
# LINE Developers Console → Messaging API
# ⚠️ 舊憑證曾明碼寫在 legacy/app.py，務必先 reissue token / regenerate secret
LINE_CHANNEL_ACCESS_TOKEN=
LINE_CHANNEL_SECRET=

# 地端 LLM（Ollama 跑在宿主機，不在容器裡——見 README 決策 15）
# 沒有任何雲端 API 金鑰：轉錄與抽取都在本機完成。
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=qwen3.5:9b

# Google 行事曆
#
# 🔴 只想讓所有人用「預填連結」的話，下面四個 GOOGLE_ 全部留白即可（決策 27）——
#    不需要 OAuth、不受 Google 的 100 人終身上限與 4-6 週審核限制。
#    使用者點卡片上的按鈕會跳出 LINE、開 Google 的新增活動頁，欄位已經填好。
#
# 要讓某些人「一鍵整批匯入 + 改時間會連動」，才需要下面這一整段（決策 26）：
# 把他們的 LINE userId 逗號分隔填進來，並填齊四個憑證。
# ⚠️ 白名單有人卻沒填齊憑證，core 會**啟動失敗**——那個組合一定是壞的。
CALENDAR_OAUTH_USER_IDS=

# 1. GCP 建專案 → 啟用 Google Calendar API
# 2. Credentials → Create credentials → OAuth client ID → 類型選「Desktop app」
# 3. ⚠️ OAuth consent screen 按下「PUBLISH APP」切到 In Production。
#    停在 Testing 的話，Google 會在七天後撤銷 refresh token——
#    症狀是「用了一週之後，匯入按鈕突然全部失效」。
#    授權腳本只要 calendar.app.created（非機密範圍），所以 Publish
#    不需要通過任何審核，也沒有 100 人上限。見決策 27。
# 4. 跑 `python3 deploy/google-calendar-auth.py`，把它印出來的兩個值貼到下面
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REFRESH_TOKEN=
GOOGLE_CALENDAR_ID=
# 使用者講了幾點但沒講多久時，事件要多長
CALENDAR_DEFAULT_DURATION_MINUTES=60

# 基礎設施（本機開發用預設值，正式環境必換）
POSTGRES_DB=svra
POSTGRES_USER=svra
POSTGRES_PASSWORD=svra-dev-only
RABBITMQ_USER=svra
RABBITMQ_PASSWORD=svra-dev-only

# core
# 8443 是對外的 webhook 埠；actuator 走 8444，不對外開（見 README 決策 20）
SERVER_PORT=8443
MANAGEMENT_PORT=8444
# core 與 whisper-worker 交換音檔的共享目錄。
# 相對路徑會依「從哪裡啟動」而變，run-core.sh 會把它指成絕對路徑。
AUDIO_DIR=./data/audio

# Whisper worker
# tiny/base/small/medium/large-v3 —— 首次煙霧測試建議 tiny（模型小、下載快）
WHISPER_MODEL=phate334/Breeze-ASR-25-ct2   # 聯發科台灣調校版；改 small 可換回快但較不準的
WHISPER_DEVICE=cpu
WHISPER_COMPUTE_TYPE=int8
# 轉錄成功後刪掉音檔。逐字稿已經進資料庫，留著只是讓語音資料一直堆積。
WHISPER_DELETE_AUDIO=true
