<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>

    <parent>
        <groupId>org.springframework.boot</groupId>
        <artifactId>spring-boot-starter-parent</artifactId>
        <version>4.1.0</version>
        <relativePath/>
    </parent>

    <groupId>io.svra</groupId>
    <artifactId>svra-core</artifactId>
    <version>0.1.0-SNAPSHOT</version>
    <name>svra-core</name>
    <description>SVRA core — LINE webhook 接收、佇列編排、LLM 層、RAG</description>

    <properties>
        <java.version>21</java.version>
    </properties>

    <dependencyManagement>
        <dependencies>
            <!-- Spring AI 用 BOM 管版本，換供應商（Anthropic → Ollama）只要換 starter -->
            <dependency>
                <groupId>org.springframework.ai</groupId>
                <artifactId>spring-ai-bom</artifactId>
                <version>2.0.0</version>
                <type>pom</type>
                <scope>import</scope>
            </dependency>
            <dependency>
                <groupId>org.springframework.modulith</groupId>
                <artifactId>spring-modulith-bom</artifactId>
                <version>2.1.0</version>
                <type>pom</type>
                <scope>import</scope>
            </dependency>
        </dependencies>
    </dependencyManagement>

    <dependencies>
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-web</artifactId>
        </dependency>
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-validation</artifactId>
        </dependency>
        <!--
            決策 22：webhook 驗簽從 Controller 移到 Spring Security。
            注意副作用——security 一上 classpath，Boot 就會把父 context 的
            springSecurityFilterChain 也註冊進 actuator 的 management 子 context
            （ServletManagementChildContextConfiguration），8444 不會因為換了埠就豁免。
            SecurityConfig 因此必須顯式給 actuator 一條 chain，否則 Prometheus 抓不到。
        -->
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-security</artifactId>
        </dependency>
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-amqp</artifactId>
        </dependency>
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-data-jpa</artifactId>
        </dependency>
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-data-redis</artifactId>
        </dependency>
        <!--
            同 Flyway：Boot 4 把 cache 的自動設定拆到獨立模組。
            只有 spring-boot-starter-data-redis 的話，@EnableCaching 會找不到
            RedisCacheManager 而 fallback 成行程內的 ConcurrentMapCache——
            能跑、看起來正常，但快取沒有跨實例，重啟就沒了。
        -->
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-cache</artifactId>
        </dependency>
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-actuator</artifactId>
        </dependency>
        <dependency>
            <groupId>org.postgresql</groupId>
            <artifactId>postgresql</artifactId>
            <scope>runtime</scope>
        </dependency>
        <!--
            Boot 4 把 FlywayAutoConfiguration 拆到獨立模組。只放 flyway-core
            的話自動設定不會載入，migration 靜靜地不執行——是 ddl-auto=validate
            在啟動時擋下來的（用 update 就會悄悄長歪）。
        -->
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-flyway</artifactId>
        </dependency>
        <dependency>
            <groupId>org.flywaydb</groupId>
            <artifactId>flyway-core</artifactId>
        </dependency>
        <dependency>
            <groupId>org.flywaydb</groupId>
            <artifactId>flyway-database-postgresql</artifactId>
        </dependency>
        <dependency>
            <groupId>io.micrometer</groupId>
            <artifactId>micrometer-registry-prometheus</artifactId>
        </dependency>
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-test</artifactId>
            <scope>test</scope>
        </dependency>
        <dependency>
            <groupId>org.springframework.security</groupId>
            <artifactId>spring-security-test</artifactId>
            <scope>test</scope>
        </dependency>
        <dependency>
            <groupId>org.springframework.ai</groupId>
            <artifactId>spring-ai-starter-model-ollama</artifactId>
        </dependency>
        <!--
            讓「不要跨 package 亂呼叫」從慣例變成測試會失敗的約束。
            決策 7 靠 package-private 擋一部分，但擋不住 public 型別之間的
            相依——這個補上那一段。
        -->
        <dependency>
            <groupId>org.springframework.modulith</groupId>
            <artifactId>spring-modulith-starter-core</artifactId>
        </dependency>
        <dependency>
            <groupId>org.springframework.modulith</groupId>
            <artifactId>spring-modulith-starter-test</artifactId>
            <scope>test</scope>
        </dependency>

        <!-- Boot 4 把 @WebMvcTest 從 spring-boot-test-autoconfigure 拆到獨立模組 -->
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-webmvc-test</artifactId>
            <scope>test</scope>
        </dependency>
        <dependency>
            <groupId>org.springframework.amqp</groupId>
            <artifactId>spring-rabbit-test</artifactId>
            <scope>test</scope>
        </dependency>

        <!--
            整合測試跑真的 PostgreSQL。
            README 的三個核心宣稱——唯一約束擋得住 race、SKIP LOCKED 多實例安全、
            處理器跑在獨立交易——每一個都只有真的資料庫驗得了。mock 出來的
            DataIntegrityViolationException 證明的是「會寫 catch」，
            不是「約束真的在那裡」。
        -->
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-testcontainers</artifactId>
            <scope>test</scope>
        </dependency>
        <!-- Testcontainers 2.x 把 artifact 改成 testcontainers-* 前綴（1.x 是 postgresql） -->
        <dependency>
            <groupId>org.testcontainers</groupId>
            <artifactId>testcontainers-postgresql</artifactId>
            <scope>test</scope>
        </dependency>
        <dependency>
            <groupId>org.testcontainers</groupId>
            <artifactId>testcontainers-junit-jupiter</artifactId>
            <scope>test</scope>
        </dependency>
    </dependencies>

    <build>
        <plugins>
            <plugin>
                <groupId>org.springframework.boot</groupId>
                <artifactId>spring-boot-maven-plugin</artifactId>
            </plugin>

            <!--
                把 mockito-core 的實際路徑解析成 ${org.mockito:mockito-core:jar}，
                供下方 surefire 的 -javaagent 使用。
            -->
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-dependency-plugin</artifactId>
                <executions>
                    <execution>
                        <goals>
                            <goal>properties</goal>
                        </goals>
                    </execution>
                </executions>
            </plugin>

            <!--
                Mockito 需要 Java agent 才能在執行期改寫類別、產生 mock。
                沒有明確指定時，它會用 ByteBuddy「動態自我掛載」——現在可以跑，
                但 JDK 正在收掉這個能力（JEP 451），未來版本會直接失敗。
                在這裡掛成正式的 -javaagent：警告消失，升級 JDK 也不會突然壞掉。
            -->
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-surefire-plugin</artifactId>
                <configuration>
                    <argLine>-javaagent:${org.mockito:mockito-core:jar}</argLine>
                    <!--
                        eval 會呼叫真的 LLM：慢、不具決定性，結果是準確率不是紅綠燈。
                        平常跑 mvn test 不該被它拖住，要跑時用 -Peval。
                        （這裡不能只寫 excludedGroups 再靠 -Dgroups 覆蓋——
                         pom 裡明寫的設定會壓過命令列屬性，測試會一個都跑不到。）
                    -->
                    <excludedGroups>eval</excludedGroups>
                </configuration>
            </plugin>
        </plugins>
    </build>

    <profiles>
        <!-- mvn test -Peval：只跑 eval，其餘略過 -->
        <profile>
            <id>eval</id>
            <build>
                <plugins>
                    <plugin>
                        <groupId>org.apache.maven.plugins</groupId>
                        <artifactId>maven-surefire-plugin</artifactId>
                        <configuration>
                            <excludedGroups combine.self="override"/>
                            <groups>eval</groups>
                        </configuration>
                    </plugin>
                </plugins>
            </build>
        </profile>
    </profiles>
</project>
